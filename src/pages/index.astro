---
import Base from '../layouts/Base.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import GuestWall from '../components/GuestWall.astro';
import FeaturedReels from '../components/FeaturedReels.astro';
import WhyGuests from '../components/WhyGuests.astro';
import HowItWorks from '../components/HowItWorks.astro';
import RequestForm from '../components/RequestForm.astro';
import Outside from '../components/Outside.astro';
import Footer from '../components/Footer.astro';
---

<Base canonicalPath="/">
  <TopBar />
  <main id="main">
    <Hero />
    <GuestWall />
    <FeaturedReels />
    <WhyGuests />
    <HowItWorks />
    <RequestForm />
    <Outside />
  </main>
  <Footer />
</Base>
