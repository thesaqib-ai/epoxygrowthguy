---
import { Image } from 'astro:assets';
import { site, instagramUrl } from '../config';
import reelWall from '../assets/hero/reel-wall.png';
---

<section class="relative overflow-hidden">
  <!--
    Lighting, all CSS, so there is no extra request and nothing to load.

    The previous glow sat at -right-1/4 -top-1/3 at 13% and was effectively
    invisible: on a wide screen it fell off the edge behind the reel wall,
    leaving the headline on flat black. These two are placed to light the
    content rather than the margin.

    Still one colour. The second is plain white, which is light rather than a
    third hue, so the kit's "never 3+ colours" rule holds.
  -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <!-- Red spill from behind the reel wall, reaching across the headline. -->
    <div
      class="absolute -top-[30%] right-[-12%] h-[58rem] w-[58rem] rounded-full opacity-[0.22] blur-[130px]"
      style="background: radial-gradient(closest-side, #FF0033, transparent 72%)"
    >
    </div>
    <!-- A soft lift top left, so the first thing read is not sitting on nothing. -->
    <div
      class="absolute -left-[12%] -top-[28%] h-[42rem] w-[42rem] rounded-full opacity-[0.07] blur-[110px]"
      style="background: radial-gradient(closest-side, #FFFFFF, transparent 70%)"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40"
      style="background: linear-gradient(to bottom, transparent, #0B0B0C)"
    >
    </div>
  </div>

  <!--
    Less padding at the top than the shared rhythm gives. The hero follows the
    nav rather than another section, so it does not need clearance from one,
    and the gap under the bar was reading as a void.
  -->
  <div class="wrap pb-section pt-8 sm:pt-10">
    <div class="grid gap-10 lg:grid-cols-[1fr_380px] lg:items-center lg:gap-14">
      <div class="reveal">
        <!--
          The kit prefixes its eyebrow with a short red dash. It also puts a
          red mark on the left, which is the side that had nothing on it.
        -->
        <p class="eyebrow flex items-center gap-3">
          <span class="h-[2px] w-8 shrink-0 bg-accent"></span>
          {site.seriesName}
        </p>

        <!--
          The kit's core move: white headline, one red keyword. The copy is
          unchanged from the brief, the colour just lands on the two words the
          whole series is about.

          Capped at 6xl rather than 7xl now the collage shares the row, so the
          headline does not wrap to five lines in a narrower column.
        -->
        <h1 class="mt-5 text-[2.75rem] leading-[0.95] sm:text-6xl">
          Conversations with the people building the <span class="keyword"
            >epoxy industry</span
          >.
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted sm:text-xl">
          Short, honest interviews with installers, artists, suppliers and
          educators across the US, Canada, the UK and Australia.
        </p>

        <div class="mt-9 flex flex-wrap items-center gap-3">
          <a href="#request" class="btn btn-primary">Request an interview</a>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener"
            class="btn btn-ghost"
          >
            Watch the interviews
          </a>
        </div>

        <p class="mt-6 text-sm text-faint">
          Hosted by {site.hostName} <span class="px-1">·</span>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener"
            class="text-muted underline decoration-ink-600 underline-offset-4 transition-colors hover:text-accent"
          >
            @{site.instagramHandle}
          </a>
        </p>
      </div>

      <!--
        Shown on phones too, not hidden with `lg:block`. A display:none image
        is still downloaded by most browsers, so hiding it would cost the
        mobile visitor the bytes and give them nothing. It is real proof that
        the series exists, so it earns its place on every screen.
      -->
      <div class="reveal" style="--reveal-delay: 120ms">
        <Image
          src={reelWall}
          alt="Six recent interviews from the series, as Instagram reel thumbnails"
          widths={[380, 760]}
          sizes="(min-width: 1024px) 380px, 100vw"
          {/*
            Lazy, not eager. On desktop it sits in the first viewport, so the
            browser fetches it straight away regardless. On a phone it is below
            the fold, and eager would have it competing with the webfonts on a
            4G connection for something nobody has scrolled to yet.
          */}
          loading="lazy"
          decoding="async"
          class="mx-auto w-full max-w-md lg:max-w-none"
        />
      </div>
    </div>
  </div>
</section>
