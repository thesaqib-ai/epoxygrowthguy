---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { approvedReels } from '../data/guests';

const reels = approvedReels();

// Thumbnails are optimized at build time. Drop a 9:16 image into
// src/assets/reels/ and point `thumbnail` at the file name.
const thumbs = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/reels/*.{jpeg,jpg,png,webp,avif}',
);

const cards = await Promise.all(
  reels.map(async (reel) => {
    // Same as guest photos: a file named after the guest slug is found on its
    // own, and setting `thumbnail` explicitly overrides that.
    const bySlug = Object.keys(thumbs).find((path) => {
      const base = path.split('/').pop()?.replace(/\.[^.]+$/, '');
      return base === reel.guestSlug;
    });
    const key = reel.thumbnail
      ? `/src/assets/reels/${reel.thumbnail}`
      : bySlug;
    const loader = key ? thumbs[key] : undefined;
    return { reel, image: loader ? (await loader()).default : undefined };
  }),
);
---

{
  cards.length > 0 && (
    <Section id="watch" heading="Watch a few">
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        {cards.map(({ reel, image }, i) => (
          <a
            href={reel.url}
            target="_blank"
            rel="noopener"
            class="reveal group block"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <div class="relative aspect-[9/16] overflow-hidden rounded-2xl border border-white/5 bg-ink-900">
              {image ? (
                <Image
                  src={image}
                  alt={`Interview with ${reel.guest.name || reel.guest.business}`}
                  width={360}
                  height={640}
                  densities={[1, 2]}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              ) : (
                <div
                  class="h-full w-full"
                  style="background: linear-gradient(160deg, #1b1b1f, #0b0b0c 60%)"
                  aria-hidden="true"
                />
              )}

              <div
                class="absolute inset-0"
                style="background: linear-gradient(to top, rgba(11,11,12,0.92) 0%, rgba(11,11,12,0.15) 45%, transparent 70%)"
                aria-hidden="true"
              />

              <span
                class="absolute left-1/2 top-1/2 flex h-12 w-12 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-ink-950/60 ring-1 ring-white/20 backdrop-blur-sm transition-colors group-hover:bg-gold-400"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="ml-0.5 h-5 w-5 fill-paper transition-colors group-hover:fill-ink-950"
                >
                  <path d="M8 5.5v13l11-6.5L8 5.5Z" />
                </svg>
              </span>

              <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
                {(reel.guest.name || reel.guest.business) && (
                  <p class="font-display text-sm text-paper sm:text-base">
                    {reel.guest.name || reel.guest.business}
                  </p>
                )}
                <p class="mt-1 text-xs leading-snug text-muted sm:text-sm">
                  “{reel.quote}”
                </p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </Section>
  )
}
