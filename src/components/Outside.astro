---
import { site } from '../config';
---

<section class="wrap pb-16 pt-4 sm:pb-24">
  <div
    class="reveal max-w-2xl rounded-[20px] border border-white/[0.06] bg-ink-850 p-5 sm:p-6"
  >
    <h2 class="text-sm font-semibold normal-case tracking-normal text-muted"
      style="font-family: var(--font-sans)">
      Outside the interviews
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-faint sm:text-base">
      I also build AI phone systems for coating companies. They answer the calls
      you miss while you're on a job, qualify the homeowner and book the
      estimate into your calendar.
    </p>
    <a
      href={site.autosinqUrl}
      target="_blank"
      rel="noopener"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent-bright underline decoration-accent/30 underline-offset-4 transition-colors hover:decoration-accent"
    >
      See how it works at autosinq.com
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</section>
