---
import { site } from '../config';
---

<section class="wrap pb-16 pt-4 sm:pb-24">
  <div
    class="reveal max-w-2xl rounded-[20px] border border-white/[0.06] bg-ink-850 p-5 sm:p-6"
  >
    <h2 class="text-sm font-semibold normal-case tracking-normal text-muted"
      style="font-family: var(--font-sans)">
      Outside the interviews
    </h2>
    <!--
      Points at the day job without naming the product. No benefits stacked up,
      no arrow pushing you onward. The link is just the address, so anyone
      curious can go and nobody feels sold to.
    -->
    <p class="mt-3 text-sm leading-relaxed text-faint sm:text-base">
      See how I help epoxy contractors grow at <a
        href={site.autosinqUrl}
        target="_blank"
        rel="noopener"
        class="text-accent-bright underline decoration-accent/30 underline-offset-4 transition-colors hover:decoration-accent"
        >autosinq.com</a
      >.
    </p>
  </div>
</section>
