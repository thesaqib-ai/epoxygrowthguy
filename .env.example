# Copy to .env for local work. Never commit .env.
# In production these live in the Cloudflare Pages project settings.

# Build time, readable by the browser. Safe to expose.
PUBLIC_TURNSTILE_SITE_KEY=

# Runtime only, used inside the Pages Function. Never exposed to the browser.
TURNSTILE_SECRET_KEY=

# Storage. "supabase" (default) or "airtable".
STORE_TARGET=supabase

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when STORE_TARGET=airtable
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=interview_requests

# Where the "new request" email lands. Keep a personal inbox out of the repo
# by setting this in Cloudflare rather than here. Falls back to the contact
# address in src/config.ts.
NOTIFY_EMAIL=

# Transactional email, through Resend. This is the same key and the same
# verified domain the Autosinq site uses, so there is no new DNS to set up.
# Copy it from the Autosinq Pages project, or from resend.com/api-keys.
RESEND_API_KEY=
